  {
    "id": "124_002",
    "question": "Find $\\displaystyle\\lim_{x \\to 2} \\frac{x^2 - 4}{x - 2}$.",
    "solution_steps": [
      "Factor the numerator: $x^2 - 4 = (x+2)(x-2)$",
      "Cancel common factor: $\\frac{(x+2)(x-2)}{x-2} = x + 2$",
      "Evaluate at $x = 2$: $2 + 2 = 4$"
    ],
    "final_answer": "$4$",
    "topic": "limits",
    "difficulty": "easy"
  },
  {
    "id": "124_003",
    "question": "Find the critical points of $f(x) = x^3 - 3x + 2$ and classify them.",
    "solution_steps": [
      "Find $f'(x) = 3x^2 - 3$",
      "Set $f'(x) = 0$: $3x^2 - 3 = 0 \\Rightarrow x^2 = 1 \\Rightarrow x = \\pm 1$",
      "Find $f''(x) = 6x$",
      "At $x = 1$: $f''(1) = 6 > 0$, so local minimum",
      "At $x = -1$: $f''(-1) = -6 < 0$, so local maximum"
    ],
    "final_answer": "$x = 1$ (local min), $x = -1$ (local max)",
    "topic": "optimization",
    "difficulty": "medium"
  }
]
