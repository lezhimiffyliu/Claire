# Frontend config (copy to web/.env.local).
VITE_API_URL=http://localhost:8000

# Clerk (target auth provider). When set, ProblemPractice sends a verified Clerk
# session token to the backend; until then the app falls back to the legacy
# Supabase session automatically.
VITE_CLERK_PUBLISHABLE_KEY=

# Legacy Supabase (retired once Clerk is fully wired).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
