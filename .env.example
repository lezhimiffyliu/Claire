# Claire — environment configuration (copy to .env and fill in).
# NEVER commit real secrets. The typed-answer path (/api/attempt) uses the
# Postgres + Clerk vars below; the remaining vars power legacy endpoints
# (/chat, mobile upload, quota, payments) that are not yet migrated.

# ── Standard Postgres persistence (SQLAlchemy + Alembic) ──────────────────────
# Local dev (default if unset): postgresql+psycopg2://localhost:5432/claire
# Neon (prod): postgresql+psycopg2://USER:PASSWORD@HOST/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg2://localhost:5432/claire

# ── Clerk authentication (backend JWT verification) ───────────────────────────
# Issuer is your Clerk Frontend API URL. JWKS URL defaults to
# <issuer>/.well-known/jwks.json. Audience is optional.
CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev
# CLERK_JWKS_URL=
# CLERK_AUDIENCE=

# ── LLM providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# ── Legacy Supabase (auth/storage for /chat, mobile, quota, payments) ─────────
# Being retired; not used by /api/attempt. Remove once those paths migrate.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# ── Stripe (payments) ─────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# ── Misc ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:8502
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
